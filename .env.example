# Local SQLite is the default. On Render set a PostgreSQL URL.
DATABASE_URL=
SECRET_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# EmailJS over HTTPS: connect Gmail and create the code template first.
# EmailJS takes priority over Brevo/Resend when any EMAILJS_* setting is set.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Set this if private-key authorization is enabled in EmailJS Account > Security.
EMAILJS_PRIVATE_KEY=
# Alternative HTTPS providers. MAIL_FROM is only needed for these or local SMTP.
# For Brevo, verify MAIL_FROM as a sender in your Brevo account first.
BREVO_API_KEY=
# For Resend, use a sender on your verified domain for real recipients.
RESEND_API_KEY=
MAIL_FROM=
# Optional local SMTP fallback (Gmail app password).
MAIL_USERNAME=
MAIL_PASSWORD=
# Only enable on a trusted local machine, never for public student input.
ENABLE_CODE_EXECUTION=false
