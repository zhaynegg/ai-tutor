# Local SQLite is the default. On Render set a PostgreSQL URL.
DATABASE_URL=
SECRET_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# HTTPS email for Render. Brevo takes priority when both API keys are set.
# For Brevo, verify MAIL_FROM as a sender in your Brevo account first.
BREVO_API_KEY=
# For Resend, use a sender on your verified domain for real recipients.
RESEND_API_KEY=
MAIL_FROM=
# Optional local SMTP fallback (Gmail app password).
MAIL_USERNAME=
MAIL_PASSWORD=
# Only enable on a trusted local machine, never for public student input.
ENABLE_CODE_EXECUTION=false
